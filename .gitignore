# Worktrees criados por subagentes do Claude Code
.claude/worktrees/
# Lock do agendador (ScheduleWakeup) — runtime do harness, não config do projeto
.claude/scheduled_tasks.lock
# Permissões locais do Claude Code — config por máquina, não vai pro repo.
.claude/settings.local.json
# Memória pessoal do Claude Code (URLs de sandbox, credenciais de teste) — nunca no repo.
CLAUDE.local.md
# Logs locais de execução de agentes/skills — só local
.claude/logs/
# Skills do Claude Code (ferramental por-máquina, não código do projeto)
.claude/skills/
.agents/

# --- Config local de MCP servers ---
# Cada dev/ambiente aponta para project_ref próprio do Supabase; não deve entrar no repo
.mcp.json

# --- Banco local / temp ---
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# --- Docker ---
.docker/

# --- Playwright MCP snapshots ---
# Capturam DOM acessível, incluindo valores digitados em campos de senha. Nunca commitar.
.playwright-mcp/

# --- Evidências do Playwright (screenshots) ---
# PNGs gerados por mcp__playwright__browser_take_screenshot não vão pro repo.
# Exceções: screenshots permanentes em docs/ e assets em interface/public/.
*.png
!docs/**/*.png
!interface/public/**/*.png
.playwright-evidence/

# DevContext
.devcontext

# --- Artefatos de trabalho local (debug dumps / prints soltos) ---
# Dumps de depuração e prints de evals gerados na raiz; não vão pro repo.
_dump_*.txt
/evals-*.jpeg
/evals-*.jpg

# Export de contatos reais (PII de clientes); só local, nunca no repo.
contacts*.csv

# Amostras de calibração dos judges (scripts/calibracao): carregam o texto das bolhas e o
# contexto da conversa real. PII de cliente — só local, nunca no repo.
amostra_calibracao*.csv
*_calibracao_rotulada*.csv

# O harness de eval do corpus (scripts/eval_corpus/) passou a ser VERSIONADO — só o código.
# Os artefatos com @lid de clientes reais (PII) continuam fora do repo, agora pelo .gitignore
# do próprio diretório, que separa código de dado arquivo a arquivo.

# --- migracao entre maquinas (scripts locais) ---
_migracao/

# Artefatos locais: extensao do VS Code e prompt renderizado (saida gerada). Nunca no repo.
*.vsix
prompt_agente_renderizado.md

# --- Referências de engenharia de prompt (só local, nunca no repo) ---
# System prompts de terceiros usados como referência, e as auditorias derivadas deles.
# Ficam fora do git de propósito: uma auditoria nova dos nossos prompts tem de poder rodar
# CEGA ao resultado da anterior, e agente que acha a auditoria antiga (ou o arquivo de
# referência no histórico) recicla a triagem em vez de refazê-la.
/OPUS-5.md
/CLAUDE-FABLE-5.md
/5.6-Codex_SystemPrompt.md
/.scratch/auditoria_prompts_referencia_*.md

# Cenários do rig de simulação de cliente (conversas reais do vendedor — PII). Fonte da skill
# simular-cliente-rig, que o lê por caminho absoluto no disco; só local, nunca no repo.
/conversas_chave_vendedor.html

# Artefatos de medicao/rodadas (JSONs de eval); specs versionadas ficam via `git add -f`
/.scratch/
